[Unit]
Description=Tonghong3 ERP backend (FastAPI / uvicorn)
After=network.target tonghong3-mrp.service
Wants=tonghong3-mrp.service

[Service]
Type=simple
WorkingDirectory=/tonghong3/backend
Environment=HOME=/root
Environment=PYTHONUNBUFFERED=1
Environment=TONGHONG_ENV_FILE=/tonghong3/.env
ExecStart=/tonghong3/tools/native/run-backend.sh
Restart=always
RestartSec=3
TimeoutStartSec=180
KillMode=mixed

[Install]
WantedBy=multi-user.target tonghong3.target
