[Unit]
Description=Tonghong3 frontend (Vite dev)
After=network.target tonghong3-backend.service
Wants=tonghong3-backend.service

[Service]
Type=simple
WorkingDirectory=/tonghong3/frontend
Environment=HOME=/root
Environment=NODE_ENV=development
Environment=TONGHONG_ENV_FILE=/tonghong3/.env
ExecStart=/tonghong3/tools/native/run-frontend.sh
Restart=always
RestartSec=3
TimeoutStartSec=180
KillMode=mixed

[Install]
WantedBy=multi-user.target tonghong3.target
