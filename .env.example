# Stack native (systemd): ./tools/stack-native.sh install && ./tools/stack-native.sh start
#
# Migrasi DB (Alembic), native:
#   cd backend && .venv/bin/alembic revision --autogenerate -m "deskripsi_perubahan"
#   .venv/bin/alembic upgrade head

APP_ENV=dev

# Zona waktu bisnis (aplikasi + MariaDB session) — GMT+7
TZ=Asia/Jakarta
APP_TIMEZONE=Asia/Jakarta

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=tonghong
MYSQL_USER=tonghong
MYSQL_PASSWORD=tonghong_secret
# Port host untuk DBeaver: 3306 (default) atau 8001 jika 3306 diblokir firewall
MYSQL_PORT=3306
MYSQL_ALT_PORT=8001

# MRP shopfloor (DB terpisah di MariaDB yang sama)
MRP_DB_NAME=tonghong_mrp
MRP_DB_USER=tonghong_mrp
MRP_DB_PASSWORD=tonghong_mrp_secret
MRP_SECRET_KEY=change-me-dev-only
MRP_DB_HOST=127.0.0.1
MRP_DB_PORT=3306
MRP_UPSTREAM_URL=http://127.0.0.1:5010
# false di production: jangan auto-insert customers dari teks bebas MRP
MRP_AUTO_CREATE_ERP_CUSTOMER=false
ERP_DB_NAME=tonghong
# Kredensial baca katalog ERP (default = MYSQL_USER / MYSQL_PASSWORD). Jangan pakai root.
# ERP_DB_USER=tonghong
# ERP_DB_PASSWORD=tonghong_secret
# ERP_DB_HOST=127.0.0.1
# ERP_DB_PORT=3306
# Path default katalog raw material di container MRP (volume ./mrp)
# MRP_RAW_MATERIAL_XLS=/app/data/Master Item Raw Material.xls

DATABASE_URL=mysql+pymysql://tonghong:tonghong_secret@127.0.0.1:3306/tonghong
BACKEND_PORT=8000
WEB_PORT=8080
VITE_API_PROXY=http://127.0.0.1:8000
VITE_HMR_PROTOCOL=ws
VITE_HMR_PORT=5173
VITE_HMR_CLIENT_PORT=8080

CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080,http://192.168.2.118:8080,http://10.227.82.65:8080

JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=720

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

DEMO_USERS_PASSWORD=TonghongDemo2026
