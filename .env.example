# Default stack: mariadb + backend + web (port WEB_PORT, build statis).
# Dev + HMR: docker compose --profile dev up -d
#
# Migrasi DB (Alembic), dari host:
#   docker compose exec backend alembic revision --autogenerate -m "deskripsi_perubahan"
#   docker compose exec backend alembic upgrade head

# Environment aplikasi:
# - dev/local/development/test: mengizinkan default auth untuk development lokal
# - selain itu (mis. production/staging): WAJIB override JWT_SECRET + ADMIN_*
APP_ENV=dev

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=tonghong
MYSQL_USER=tonghong
MYSQL_PASSWORD=tonghong_secret
MYSQL_PORT=3306

# Jika 8000 sudah dipakai proses lain di host, ubah (mis. 8002) lalu akses API di port itu.
BACKEND_PORT=8000
# WEB_PORT: frontend production (nginx + dist) — origin Cloudflare
WEB_PORT=8080
# WEB_HMR_PORT: port nginx HMR (profile dev). Untuk domain yang sama set = WEB_PORT (8080).
WEB_HMR_PORT=8080
# WEB_STATIC_PORT: opsional — jika web statis dipindah saat HMR (tidak dipakai compose default)
WEB_STATIC_PORT=8090

# HMR lewat domain (HTTPS / Cloudflare) — wajib sama dengan URL browser
HMR_PUBLIC_HOST=tonghong.creativedigitalsolutions.id
HMR_WSS_PROTOCOL=wss
HMR_PUBLIC_CLIENT_PORT=443
VITE_DEV_PUBLIC_ORIGIN=https://tonghong.creativedigitalsolutions.id

# Switch stack:
#   ./tools/stack-hmr-domain.sh   → HMR di https://tonghong... (stop web, port 8080)
#   ./tools/stack-prod-web.sh     → build statis production
#   ./tools/stack-prod-web.sh --build  → rebuild image web dulu

# Origin browser yang boleh memanggil API (pisahkan koma)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:8080,http://127.0.0.1:8081,https://tonghong.creativedigitalsolutions.id

# Auth (WAJIB ganti di staging/production)
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=720

# Bootstrap admin (hanya dipakai jika tabel users masih kosong)
# WAJIB ganti di staging/production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# User demo per role (auto-seed di APP_ENV=dev/local/test jika username belum ada)
DEMO_USERS_PASSWORD=TonghongDemo2026

# Hanya untuk `docker compose --profile dev up` (Vite → proxy ke backend)
# VITE_API_PROXY=http://backend:8000

# Stack Trello — dev todo / review (tanpa auth Tonghong)
TRELLO_PORT=8003
TRELLO_PORT_DEV=8004
# OAuth Trello: GET http://localhost:8003/api/v1/trello/authorize-url
TRELLO_API_KEY=
TRELLO_API_SECRET=
TRELLO_ACCESS_TOKEN=
TRELLO_APP_NAME=Tonghong ERP
# Board contoh: https://trello.com/b/IalduaQh/tonghong → ID = IalduaQh
TRELLO_DEFAULT_BOARD_ID=
TRELLO_DEFAULT_LIST_ID=
