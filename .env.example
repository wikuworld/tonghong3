# Salin ke .env dan sesuaikan
#
# Migrasi DB (Alembic), dari host:
#   docker compose exec backend alembic revision --autogenerate -m "deskripsi_perubahan"
#   docker compose exec backend alembic upgrade head

# Environment aplikasi:
# - dev/local/development/test: mengizinkan default auth untuk development lokal
# - selain itu (mis. production/staging): WAJIB override JWT_SECRET + ADMIN_*
APP_ENV=dev

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=tonghong
MYSQL_USER=tonghong
MYSQL_PASSWORD=tonghong_secret
MYSQL_PORT=3306

# Jika 8000 sudah dipakai proses lain di host, ubah (mis. 8002) lalu akses API di port itu.
BACKEND_PORT=8000
WEB_PORT=8080
# Hanya dipakai `docker compose --profile dev up` — jangan sama dengan WEB_PORT.
WEB_HMR_PORT=8081

# Origin browser yang boleh memanggil API (pisahkan koma). Sertakan :8081 jika dev lewat web-hmr.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:8080,http://127.0.0.1:8081,https://tonghong.creativedigitalsolutions.id

# Auth (WAJIB ganti di staging/production)
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=720

# Bootstrap admin (hanya dipakai jika tabel users masih kosong)
# WAJIB ganti di staging/production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Hanya untuk `docker compose --profile dev up` (Vite → proxy ke backend)
# VITE_API_PROXY=http://backend:8000
