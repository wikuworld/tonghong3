# Stack dev: mariadb + backend + frontend-dev + web-hmr
# Jalankan: docker compose up -d
#
# Migrasi DB (Alembic), dari host:
#   docker compose exec backend alembic revision --autogenerate -m "deskripsi_perubahan"
#   docker compose exec backend alembic upgrade head

APP_ENV=dev

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=tonghong
MYSQL_USER=tonghong
MYSQL_PASSWORD=tonghong_secret

BACKEND_PORT=8000
WEB_PORT=8080

CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080,http://192.168.2.118:8080,http://10.227.82.65:8080

JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=720

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

DEMO_USERS_PASSWORD=TonghongDemo2026
