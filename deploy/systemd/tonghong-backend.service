[Unit]
Description=Tonghong FastAPI backend
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=developer
Group=developer
WorkingDirectory=/home/developer/project/backend
EnvironmentFile=-/home/developer/project/.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/home/developer/project/backend/.venv/bin/alembic upgrade head
ExecStart=/home/developer/project/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --loop asyncio
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
